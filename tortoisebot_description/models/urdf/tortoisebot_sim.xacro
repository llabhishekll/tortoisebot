<?xml version="1.0" ?>
<robot name="tortoisebot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find tortoisebot_description)/models/urdf/tortoisebot.xacro"/>
  <xacro:tortoisebot_body use_sim="true"/>

  <!-- Gazebo Sim plugins and sensors -->
  <gazebo>
    <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
      <joint_name>${left_wheel_joint}</joint_name>
      <joint_name>${right_wheel_joint}</joint_name>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
      <left_joint>${left_wheel_joint}</left_joint>
      <right_joint>${right_wheel_joint}</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <max_linear_velocity>${max_linear_velocity}</max_linear_velocity>
      <min_linear_velocity>-${max_linear_velocity}</min_linear_velocity>
      <max_angular_velocity>${max_angular_velocity}</max_angular_velocity>
      <min_angular_velocity>-${max_angular_velocity}</min_angular_velocity>
      <max_linear_acceleration>${max_linear_velocity}</max_linear_acceleration>
      <min_linear_acceleration>-${max_linear_velocity}</min_linear_acceleration>
      <max_angular_acceleration>${max_angular_velocity}</max_angular_acceleration>
      <min_angular_acceleration>-${max_angular_velocity}</min_angular_acceleration>
      <tf_topic>/model/tortoisebot/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>${base_footprint_frame}</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <publish_tf>false</publish_tf>
    </plugin>
  </gazebo>

  <gazebo reference="${laser_frame}">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <visualize>true</visualize>
      <topic>/scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <frame_id>${laser_frame}</frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="${camera_frame}">
    <sensor type="camera" name="camera_sensor">
      <always_on>true</always_on>
      <update_rate>5.0</update_rate>
      <camera name="camera_sensor">
        <horizontal_fov>1.085595</horizontal_fov>
        <image>
          <width>800</width>
          <height>600</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.03</near>
          <far>100</far>
        </clip>
      </camera>
      <topic>/camera/image_raw</topic>
      <frame_id>${camera_frame}</frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="${base_link_frame}">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="${left_wheel_frame}">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="${right_wheel_frame}">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="${caster_frame}">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

</robot>
